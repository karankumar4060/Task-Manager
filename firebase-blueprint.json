{
  "entities": {
    "User": {
      "title": "User",
      "description": "Public and private user profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Member"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Project": {
      "title": "Project",
      "description": "A container for team tasks.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId"]
    },
    "ProjectMember": {
      "title": "Project Member",
      "description": "Mapping of users to projects with specific roles within the project.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["Owner", "Admin", "Member"] },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "userId", "role"]
    },
    "Task": {
      "title": "Task",
      "description": "A single unit of work within a project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assignedTo": { "type": "string" },
        "status": { "type": "string", "enum": ["todo", "in-progress", "completed"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "title", "status", "priority", "createdBy"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles. Access restricted to the user themselves for private data."
    },
    "projects/{projectId}": {
      "schema": "Project",
      "description": "Projects created by users."
    },
    "projects/{projectId}/members/{memberId}": {
      "schema": "ProjectMember",
      "description": "Members of a specific project."
    },
    "projects/{projectId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks associated with a project."
    }
  }
}
